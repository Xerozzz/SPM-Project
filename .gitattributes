# Check everything out with LF, on every platform. The Makefile, the Dockerfiles and the
# shell commands in docker-compose.yml all run inside Linux containers, where CRLF line
# endings break them — so line endings are a portability decision, not a preference.
* text=auto eol=lf

# Lock files are generated. linguist-generated collapses them in GitHub's diff view;
# we deliberately do NOT mark them -diff, so `git diff` still works when a lock file
# conflicts and somebody has to read it.
package-lock.json linguist-generated
