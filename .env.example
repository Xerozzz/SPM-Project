# Copy this file to `.env` and adjust. `.env` is gitignored — never commit real secrets.
#
#     cp .env.example .env
#
# Every variable the stack reads is listed here. Docker Compose falls back to the
# defaults baked into docker-compose.yml, so the stack also starts with no .env at all
# (that is how CI runs it), but a local .env is the documented path.

# ---------------------------------------------------------------- database
POSTGRES_USER=connectsphere
POSTGRES_PASSWORD=connectsphere
POSTGRES_DB=connectsphere

# Host port to publish PostgreSQL on. Change this if 5432 is already taken on your machine
# (a local PostgreSQL install, or another project's container). Nothing inside the stack
# is affected: the API always reaches the database at db:5432 on the Compose network.
POSTGRES_PORT=5432

# SQLAlchemy 2.0 URL using the psycopg v3 driver.
# Host is `db` from inside Compose; use `localhost` when running the API on your machine.
DATABASE_URL=postgresql+psycopg://connectsphere:connectsphere@db:5432/connectsphere

# ---------------------------------------------------------------- auth
# Deliberately has no default in core/config.py: the API refuses to start without one,
# so nobody can accidentally ship a well-known signing key.
JWT_SECRET=local-development-only-change-me
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------- http
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- frontend
# Where the Vite dev server forwards /api and /health. `api` is the Compose service name.
VITE_API_PROXY_TARGET=http://api:8000
